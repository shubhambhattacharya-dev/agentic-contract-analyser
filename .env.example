

# ── Runtime ──
NODE_ENV=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# ── Generation: Groq (primary) ──
GROQ_API_KEY=
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192
GROQ_TEMPERATURE=0.2

# ── Generation: Gemini (fallback) + embeddings (primary) ──
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.2

# ── Model routing ──
GENERATION_PROVIDER=groq
EMBEDDING_PROVIDER=gemini
GENERATION_FALLBACK_CHAIN=groq,gemini

# ── Local Redis (development) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=devpassword

# ── Production storage (required when NODE_ENV=production) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# ── Ingestion / retrieval limits ──
MAX_FILE_BYTES=26214400
EMBED_BATCH_SIZE=100
MAX_AGENT_ROUNDS=4
RETRIEVAL_TOP_K=15
INGEST_MAX_DURATION=60

# ── LLM observability (optional; self-hosted Langfuse) ──
# docker compose up -d langfuse  → http://localhost:3001 → create project → paste keys.
# LANGFUSE_LOG_CONTENT=true additionally records raw prompt/completion text.
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_LOG_CONTENT=false
